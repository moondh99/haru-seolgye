<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>5f0c1b7e-6a1e-4b6e-9d2a-3c6f4a8d1e27</UserSecretsId>
    <!-- The Aspire CLI is a repo-local dotnet tool (not on PATH), so the CLI bundle is not used;
         DCP and the dashboard come from NuGet instead. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Haru.Api\Haru.Api.csproj" />
    <ProjectReference Include="..\Haru.Mcp\Haru.Mcp.csproj" />
  </ItemGroup>

</Project>
